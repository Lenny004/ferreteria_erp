<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Confeccion.OrdenesConfeccionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
    xmlns:confection="clr-namespace:Ferreteria.PuntoVenta.Services.Confection"
    xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
    FocusManager.FocusedElement="{Binding ElementName=CustomerNameBox}">
    <!-- Atajos: Ctrl+S crear orden, F2/Ctrl+F buscar producto, Esc limpiar y F5 actualizar la bandeja. -->
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static input:ApplicationCommands.Save}" Executed="OnSaveCommandExecuted" CanExecute="OnSaveCommandCanExecute" />
        <CommandBinding Command="{x:Static input:ApplicationCommands.Find}" Executed="OnFindCommandExecuted" />
        <CommandBinding Command="{x:Static input:ApplicationCommands.Close}" Executed="OnClearCommandExecuted" />
        <CommandBinding Command="{x:Static input:NavigationCommands.Refresh}" Executed="OnRefreshCommandExecuted" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static input:ApplicationCommands.Save}" />
        <KeyBinding Key="F2" Command="{x:Static input:ApplicationCommands.Find}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static input:ApplicationCommands.Find}" />
        <KeyBinding Key="Escape" Command="{x:Static input:ApplicationCommands.Close}" />
        <KeyBinding Key="F5" Command="{x:Static input:NavigationCommands.Refresh}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Bandeja de órdenes -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Órdenes de confección" Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock Text="Órdenes del taller de cables; quedan pendientes hasta que caja las facture" Style="{StaticResource AppPanelSubtitleStyle}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="OrderSearchTextBox"
                    Style="{StaticResource AppFieldTextBoxStyle}"
                    MaxLength="{x:Static helpers:FieldConstraints.SalesHistorySearchMaxLength}"
                    helpers:WatermarkService.Watermark="Buscar por cliente, notas o técnico"
                    TextChanged="OnOrderSearchChanged"
                    TabIndex="20"
                    AutomationProperties.Name="Buscar órdenes de confección" />
                <ComboBox
                    x:Name="StatusFilterCombo"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Style="{StaticResource AppFieldComboBoxStyle}"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Static confection:ConfectionOrderStatusOptions.All}"
                    SelectionChanged="OnStatusFilterChanged"
                    TabIndex="21"
                    AutomationProperties.Name="Filtrar por estado" />
            </Grid>
            <Border
                Grid.Row="2"
                Background="{StaticResource AppAzulMedio}"
                BorderBrush="{StaticResource AppAzulClaro}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppRadius_MD}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource AppGridHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ORDEN" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="FECHA" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="CLIENTE" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="REGISTRÓ" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="ÍTEMS" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="TOTAL" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="6" Text="ESTADO" Style="{StaticResource AppGridHeaderTextStyle}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="EmptyOrdersText"
                            Text="Sin órdenes para mostrar."
                            Style="{StaticResource AppTableCellStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="OrdersList" AutomationProperties.Name="Órdenes de confección">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AppDataGridRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding OrderNumber}" Style="{StaticResource AppTableCellStyle}" Foreground="{StaticResource AppRojo}" />
                                                <TextBlock Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CustomerDisplayName}" ToolTip="{Binding CustomerDisplayName}" TextTrimming="CharacterEllipsis" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="3" Text="{Binding EmployeeDisplayName}" ToolTip="{Binding EmployeeDisplayName}" TextTrimming="CharacterEllipsis" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="4" Text="{Binding ItemCount}" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="5" Text="{Binding TotalText}" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="6" Text="{Binding Status}" Style="{StaticResource AppTableCellStyle}" FontWeight="Bold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Nueva orden -->
        <Border
            Grid.Column="1"
            Background="{StaticResource AppAzulMedio}"
            BorderBrush="{StaticResource AppAzulClaro}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppRadius_MD}"
            Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditorPanel">
                    <TextBlock Text="Nueva orden" Style="{StaticResource AppPanelTitleStyle}" Margin="0,0,0,12" />

                    <Label Content="Cliente" Target="{Binding ElementName=CustomerNameBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="CustomerNameBox" MaxLength="{x:Static confection:ConfectionOrderDraft.CustomerNameMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Nombre (opcional; vacío = consumidor final)" Margin="0,4,0,10" TabIndex="0" AutomationProperties.Name="Nombre del cliente" />

                    <Label Content="Teléfono" Target="{Binding ElementName=CustomerPhoneBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="CustomerPhoneBox" MaxLength="{x:Static confection:ConfectionOrderDraft.CustomerPhoneMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Teléfono (opcional)" Margin="0,4,0,10" TabIndex="1" AutomationProperties.Name="Teléfono del cliente" />

                    <Label Content="Indicaciones del trabajo" Target="{Binding ElementName=NotesBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="NotesBox" MaxLength="{x:Static confection:ConfectionOrderDraft.NotesMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Ej. cable 3 m con terminales (opcional)" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,4,0,10" TabIndex="2" AutomationProperties.Name="Indicaciones del trabajo" />

                    <Rectangle Height="1" Fill="{StaticResource AppAzulClaro}" Margin="0,4,0,12" />

                    <Label Content="Buscar producto (F2)" Target="{Binding ElementName=ProductSearchTextBox}" Style="{StaticResource AppFieldLabelStyle}" AutomationProperties.AcceleratorKey="F2" />
                    <TextBox x:Name="ProductSearchTextBox" MaxLength="{x:Static helpers:FieldConstraints.ProductSearchMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Código o descripción" TextChanged="OnProductSearchChanged" Margin="0,4,0,8" TabIndex="3" AutomationProperties.Name="Buscar producto" AutomationProperties.AcceleratorKey="F2, Ctrl+F" />
                    <ListBox x:Name="ProductResultsListBox" Background="Transparent" BorderThickness="0" MaxHeight="160" Margin="0,0,0,8" TabIndex="4" AutomationProperties.Name="Resultados de productos">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Code}" Style="{StaticResource AppTableCellStyle}" Foreground="{StaticResource AppRojo}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource AppTableCellStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FormattedStock}" Style="{StaticResource AppTableCellStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Label Content="Cantidad" Target="{Binding ElementName=QuantityTextBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuantityTextBox" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Cantidad" helpers:NumericInput.IsEnabled="True" helpers:NumericInput.Precision="{x:Static helpers:FieldConstraints.OrderDetailQuantityPrecision}" helpers:NumericInput.Scale="{x:Static helpers:FieldConstraints.OrderDetailQuantityScale}" Text="1" TabIndex="5" AutomationProperties.Name="Cantidad obligatoria" />
                        <Button Grid.Column="1" Content="AGREGAR" Style="{StaticResource AppActionButtonStyle}" Margin="10,0,0,0" Click="OnAgregarClick" TabIndex="6" AutomationProperties.Name="Agregar producto a la orden" />
                    </Grid>
                    <TextBlock Text="{Binding ElementName=QuantityTextBox, Path=(helpers:NumericInput.ErrorMessage)}" Foreground="{StaticResource AppError}" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.LiveSetting="Assertive" />

                    <TextBlock Text="Detalle de la orden" Style="{StaticResource AppCardLabelStyle}" Margin="0,4,0,0" />
                    <TextBlock x:Name="EmptyLinesText" Text="Sin productos agregados." Style="{StaticResource AppTableCellStyle}" Margin="0,8,0,0" />
                    <ItemsControl x:Name="LinesList" Margin="0,8,0,0" AutomationProperties.Name="Productos de la orden">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AppDataGridRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" Style="{StaticResource AppTableCellStyle}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding QuantityText}" Style="{StaticResource AppTableCellStyle}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SubtotalText}" Style="{StaticResource AppTableCellStyle}" />
                                        <Button Grid.Column="3" Content="X" Width="26" Height="24" Style="{StaticResource AppWindowButtonStyle}" Tag="{Binding ProductId}" Click="OnRemoveLineClick" AutomationProperties.Name="Quitar producto de la orden" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SubtotalText" Text="Subtotal estimado (sin IVA): $0.00" Foreground="{StaticResource AppSuccess}" FontWeight="Bold" Margin="0,10,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CreateButton" Style="{StaticResource AppPrimaryWideButtonStyle}" Click="OnCrearClick" Margin="0,0,6,0" TabIndex="7" AutomationProperties.Name="Crear orden de confección" AutomationProperties.AcceleratorKey="Ctrl+S">
                            <TextBlock Text="CREAR (Ctrl+S)" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource AppSecondaryWideButtonStyle}" Click="OnLimpiarClick" Margin="6,0,0,0" TabIndex="8" AutomationProperties.Name="Limpiar orden" AutomationProperties.AcceleratorKey="Escape">
                            <TextBlock Text="LIMPIAR (Esc)" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="StatusText" Style="{StaticResource AppTableCellStyle}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="El stock se descuenta cuando caja factura la orden." Foreground="{StaticResource AppGrisClaro}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="Ferreteria.PuntoVenta.Views.Caja.ReturnAuthorizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
        Title="Autorizar devolución" Style="{StaticResource AppDialogWindowStyle}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=PinBox}">
    <StackPanel Margin="24">
        <TextBlock Text="PIN del autorizador" Style="{StaticResource AppPanelTitleStyle}" />
        <TextBlock Text="Ingrese el PIN de un Administrador." Foreground="{StaticResource AppBlanco}" Margin="0,8,0,12" TextWrapping="Wrap" />
        <Label Content="PIN de autorización" Target="{Binding ElementName=PinBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
        <PasswordBox x:Name="PinBox" MaxLength="4" FontSize="24" Height="42" TabIndex="0" AutomationProperties.Name="PIN de autorización (obligatorio)" />
        <Grid Style="{StaticResource AppDialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="CANCELAR (Esc)" Style="{StaticResource AppActionButtonSecondaryStyle}" IsCancel="True" Click="OnCancelClick" TabIndex="1" AutomationProperties.Name="Cancelar autorización" AutomationProperties.AcceleratorKey="Escape" />
            <Button Grid.Column="1" Content="ACEPTAR (Enter)" Style="{StaticResource AppActionButtonStyle}" IsDefault="True" Click="OnAcceptClick" TabIndex="2" AutomationProperties.Name="Aceptar autorización" AutomationProperties.AcceleratorKey="Enter" />
        </Grid>
    </StackPanel>
</Window>

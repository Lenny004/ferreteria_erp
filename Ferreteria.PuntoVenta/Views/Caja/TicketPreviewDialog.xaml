<Window
    x:Class="Ferreteria.PuntoVenta.Views.Caja.TicketPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vista previa del ticket"
    Style="{StaticResource AppDialogWindowStyle}"
    Width="700"
    Height="720"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <Grid
        Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox
            x:Name="PreviewTextBox"
            IsReadOnly="True"
            FontFamily="Consolas"
            FontSize="{StaticResource AppFontSize_LG}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto" />
        <Button
            x:Name="CloseButton"
            Grid.Row="1"
            Style="{StaticResource AppSecondaryWideButtonStyle}"
            Width="180"
            Height="90"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            IsCancel="True"
            IsDefault="True"
            Click="OnCloseClick"
            TabIndex="0"
            AutomationProperties.Name="Cerrar vista previa"
            AutomationProperties.AcceleratorKey="Escape">
            <TextBlock
                Text="CERRAR (Esc)"
                Foreground="{StaticResource AppBlanco}"
                FontSize="{StaticResource AppFontSize_LG}"
                FontWeight="Bold" />
        </Button>
    </Grid>
</Window>

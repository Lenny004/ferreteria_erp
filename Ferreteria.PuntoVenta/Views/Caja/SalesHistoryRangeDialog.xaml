<Window
    x:Class="Ferreteria.PuntoVenta.Views.Caja.SalesHistoryRangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rango de fechas"
    Style="{StaticResource AppDialogWindowStyle}"
    Width="520"
    Height="360"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=FromPicker}">
    <StackPanel
        Background="{StaticResource AppAzulOscuro}"
        Margin="24">
        <TextBlock
            Text="Rango de fechas"
            Style="{StaticResource AppPanelTitleStyle}" />
        <TextBlock
            Text="Ambas fechas son inclusivas y usan la hora local de El Salvador."
            Foreground="{StaticResource AppBlanco}"
            FontSize="16"
            Margin="0,8,0,16"
            TextWrapping="Wrap" />
        <Label Content="Desde" Target="{Binding ElementName=FromPicker}" Style="{StaticResource RequiredLabelStyle}" />
        <DatePicker
            x:Name="FromPicker"
            FontSize="16"
            Margin="0,4,0,10"
            TabIndex="0"
            AutomationProperties.Name="Fecha inicial" />
        <Label Content="Hasta" Target="{Binding ElementName=ToPicker}" Style="{StaticResource RequiredLabelStyle}" />
        <DatePicker
            x:Name="ToPicker"
            FontSize="16"
            Margin="0,4,0,10"
            TabIndex="1"
            AutomationProperties.Name="Fecha final" />
        <TextBlock
            x:Name="ValidationText"
            Foreground="{StaticResource AppWarning}"
            FontSize="16"
            Visibility="Collapsed"
            TextWrapping="Wrap" />
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Content="CANCELAR"
                Style="{StaticResource AppSecondaryWideButtonStyle}"
                IsCancel="True"
                MinHeight="90"
                FontSize="16"
                Click="OnCancelClick"
                TabIndex="2"
                AutomationProperties.Name="Cancelar rango"
                AutomationProperties.AcceleratorKey="Escape" />
            <Button
                Content="ACEPTAR"
                Style="{StaticResource AppPrimaryWideButtonStyle}"
                IsDefault="True"
                MinHeight="90"
                FontSize="16"
                Click="OnAcceptClick"
                TabIndex="3"
                AutomationProperties.Name="Aceptar rango"
                AutomationProperties.AcceleratorKey="Enter" />
        </StackPanel>
    </StackPanel>
</Window>

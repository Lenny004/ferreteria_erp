<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Caja.ImpresorasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
    xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
    FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <!-- Atajos: Ctrl+S guardar, F5 actualizar y Esc cancelar la edición local. -->
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static input:ApplicationCommands.Save}" Executed="OnSaveCommandExecuted" />
        <CommandBinding Command="{x:Static input:NavigationCommands.Refresh}" Executed="OnRefreshCommandExecuted" />
        <CommandBinding Command="{x:Static input:ApplicationCommands.Close}" Executed="OnCancelCommandExecuted" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static input:ApplicationCommands.Save}" />
        <KeyBinding Key="F5" Command="{x:Static input:NavigationCommands.Refresh}" />
        <KeyBinding Key="Escape" Command="{x:Static input:ApplicationCommands.Close}" />
    </UserControl.InputBindings>
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <Grid
            Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Margin="0,0,0,16">
                <TextBlock
                    Text="Impresoras"
                    Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock
                    Text="Configure la impresora · Ctrl+S guardar · Esc cancelar · F5 actualizar"
                    Style="{StaticResource AppPanelSubtitleStyle}" />
            </StackPanel>
            <UniformGrid
                Grid.Row="1"
                Columns="3"
                Margin="0,0,0,16">
                <Border
                    Style="{StaticResource AppStatCardStyle}"
                    Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock
                            Text="Predeterminada"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="DefaultNameText"
                            Text="Sin configurar"
                            Style="{StaticResource AppCardValueStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource AppStatCardStyle}"
                    Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock
                            Text="Ancho papel"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="DefaultPaperText"
                            Text="-"
                            Style="{StaticResource AppCardValueStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource AppStatCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="Estado"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <TextBlock
                            x:Name="StatusText"
                            Text="Cargando..."
                            Style="{StaticResource AppCardValueStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid
                Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="1.3*" />
                    <ColumnDefinition
                        Width="0.9*" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{StaticResource AppAzulMedio}"
                    BorderBrush="{StaticResource AppAzulClaro}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppRadius_MD}"
                    Margin="0,0,12,0"
                    Padding="12">
                    <StackPanel>
                        <TextBlock
                            Text="Impresoras configuradas (toque una para editarla)"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <ListBox
                            x:Name="PrintersList"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,10,0,0"
                            SelectionChanged="OnPrinterSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Style="{StaticResource AppDataGridRowStyle}"
                                        Padding="8">
                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="{StaticResource AppFontSize_LG}"
                                                Style="{StaticResource AppTableCellStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Name}" />
                                            <TextBlock
                                                Text="{Binding ConnectionType}"
                                                FontSize="{StaticResource AppFontSize_LG}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock
                                                Text="{Binding PaperWidth, StringFormat={}{0} mm}"
                                                FontSize="{StaticResource AppFontSize_LG}"
                                                Style="{StaticResource AppTableCellStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock
                            Text="Impresoras detectadas en Windows"
                            Style="{StaticResource AppCardLabelStyle}"
                            Margin="0,16,0,4" />
                        <ListBox
                            x:Name="WindowsPrintersList"
                            Height="120"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Background="Transparent"
                            Foreground="{StaticResource AppBlanco}"
                            BorderThickness="0" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Style="{StaticResource AppStatCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="Configuración"
                            Style="{StaticResource AppCardLabelStyle}" />
                        <Label Content="Nombre de la impresora" Target="{Binding ElementName=NameTextBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                        <TextBox
                            x:Name="NameTextBox"
                            MaxLength="{x:Static helpers:FieldConstraints.PrinterNameMaxLength}"
                            Style="{StaticResource AppFieldTextBoxStyle}"
                            helpers:WatermarkService.Watermark="Nombre visible"
                            FontSize="{StaticResource AppFontSize_LG}"
                            TabIndex="0" />
                        <Label Content="Tipo de conexión" Target="{Binding ElementName=ConnectionCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                        <ComboBox
                            x:Name="ConnectionCombo"
                            Style="{StaticResource AppFieldComboBoxStyle}"
                            FontSize="{StaticResource AppFontSize_LG}"
                            SelectedIndex="0"
                            SelectionChanged="OnConnectionChanged"
                            TabIndex="1">
                            <ComboBoxItem
                                Content="USB (cola de Windows)"
                                Tag="USB" />
                            <ComboBoxItem
                                Content="Red (Ethernet)"
                                Tag="RED" />
                            <ComboBoxItem
                                Content="Bluetooth"
                                Tag="BLUETOOTH" />
                        </ComboBox>
                        <Label Content="Dirección IP (solo red)" Target="{Binding ElementName=IpTextBox}" Style="{StaticResource AppFieldLabelStyle}" />
                        <TextBox
                            x:Name="IpTextBox"
                            MaxLength="{x:Static helpers:FieldConstraints.PrinterIpAddressMaxLength}"
                            Style="{StaticResource AppFieldTextBoxStyle}"
                            helpers:WatermarkService.Watermark="192.168.1.100"
                            FontSize="{StaticResource AppFontSize_LG}"
                            TabIndex="2" />
                        <Label Content="Puerto (solo red)" Target="{Binding ElementName=PortTextBox}" Style="{StaticResource AppFieldLabelStyle}" />
                        <TextBox
                            x:Name="PortTextBox"
                            Style="{StaticResource AppFieldTextBoxStyle}"
                            helpers:NumericInput.IsEnabled="True"
                            MaxLength="{x:Static helpers:FieldConstraints.PrinterPortMaxLength}"
                            helpers:NumericInput.Precision="5"
                            helpers:NumericInput.Scale="0"
                            FontSize="{StaticResource AppFontSize_LG}"
                            Text="9100"
                            TabIndex="3" />
                        <Label Content="Ancho de papel" Target="{Binding ElementName=PaperCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                        <ComboBox
                            x:Name="PaperCombo"
                            Style="{StaticResource AppFieldComboBoxStyle}"
                            FontSize="{StaticResource AppFontSize_LG}"
                            SelectedIndex="0"
                            TabIndex="4">
                            <ComboBoxItem
                                Content="80 mm"
                                Tag="80" />
                            <ComboBoxItem
                                Content="58 mm"
                                Tag="58" />
                        </ComboBox>
                        <UniformGrid
                            Columns="2"
                            Margin="0,18,0,0">
                            <Button
                                Style="{StaticResource AppPrimaryWideButtonStyle}"
                                Width="Auto"
                                Margin="0,0,6,6"
                                Click="OnSaveClick"
                                TabIndex="5"
                                AutomationProperties.Name="Guardar impresora"
                                AutomationProperties.AcceleratorKey="Ctrl+S">
                                <TextBlock
                                    Text="GUARDAR (Ctrl+S)"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button
                                Style="{StaticResource AppSecondaryWideButtonStyle}"
                                Width="Auto"
                                Margin="6,0,0,6"
                                Click="OnTestClick"
                                TabIndex="6"
                                AutomationProperties.Name="Probar impresora">
                                <TextBlock
                                    Text="PRUEBA"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button
                                Style="{StaticResource AppSecondaryWideButtonStyle}"
                                Width="Auto"
                                Margin="0,6,6,0"
                                Click="OnPreviewClick"
                                TabIndex="7"
                                AutomationProperties.Name="Vista previa del ticket">
                                <TextBlock
                                    Text="VISTA PREVIA"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button
                                Style="{StaticResource AppSecondaryWideButtonStyle}"
                                Width="Auto"
                                Margin="6,6,0,0"
                                Click="OnSetDefaultClick"
                                TabIndex="8"
                                AutomationProperties.Name="Marcar impresora predeterminada">
                                <TextBlock
                                    Text="MARCAR PREDETERMINADA"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button
                                x:Name="CancelButton"
                                Style="{StaticResource AppSecondaryWideButtonStyle}"
                                Width="Auto"
                                Margin="0,6,6,0"
                                Click="OnCancelClick"
                                TabIndex="9"
                                AutomationProperties.Name="Cancelar edición"
                                AutomationProperties.AcceleratorKey="Escape">
                                <TextBlock
                                    Text="CANCELAR (Esc)"
                                    Foreground="{StaticResource AppBlanco}"
                                    FontSize="{StaticResource AppFontSize_LG}"
                                    FontWeight="Bold"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Inventario.UsuariosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
    xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
    FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}">
    <!-- Atajos: Ctrl+N nuevo, Ctrl+S guardar, F2/Ctrl+F buscar, Esc cancelar, F5 actualizar y Supr desactivar. -->
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static input:ApplicationCommands.New}" Executed="OnNewCommandExecuted" />
        <CommandBinding Command="{x:Static input:ApplicationCommands.Save}" Executed="OnSaveCommandExecuted" />
        <CommandBinding Command="{x:Static input:ApplicationCommands.Find}" Executed="OnFindCommandExecuted" />
        <CommandBinding Command="{x:Static input:ApplicationCommands.Close}" Executed="OnCancelCommandExecuted" />
        <CommandBinding Command="{x:Static input:NavigationCommands.Refresh}" Executed="OnRefreshCommandExecuted" />
        <CommandBinding Command="{x:Static input:ApplicationCommands.Delete}" Executed="OnDeleteCommandExecuted" CanExecute="OnDeleteCommandCanExecute" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static input:ApplicationCommands.New}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static input:ApplicationCommands.Save}" />
        <KeyBinding Key="F2" Command="{x:Static input:ApplicationCommands.Find}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static input:ApplicationCommands.Find}" />
        <KeyBinding Key="Escape" Command="{x:Static input:ApplicationCommands.Close}" />
        <KeyBinding Key="F5" Command="{x:Static input:NavigationCommands.Refresh}" />
        <KeyBinding Key="Delete" Command="{x:Static input:ApplicationCommands.Delete}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Lista -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Usuarios y RRHH" Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock Text="Empleados, permisos y PIN de acceso" Style="{StaticResource AppPanelSubtitleStyle}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchTextBox"
                    Style="{StaticResource AppFieldTextBoxStyle}"
                    helpers:WatermarkService.Watermark="Buscar por nombre o DUI"
                    TextChanged="OnSearchChanged"
                    TabIndex="0"
                    AutomationProperties.Name="Buscar usuario"
                    AutomationProperties.AcceleratorKey="F2, Ctrl+F" />
                <Button
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Style="{StaticResource AppSecondaryWideButtonStyle}"
                    Click="OnNuevoClick"
                    TabIndex="1"
                    AutomationProperties.Name="Nuevo usuario"
                    AutomationProperties.AcceleratorKey="Ctrl+N">
                    <TextBlock Text="NUEVO (Ctrl+N)" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                </Button>
            </Grid>
            <Border
                Grid.Row="2"
                Background="{StaticResource AppAzulMedio}"
                BorderBrush="{StaticResource AppAzulClaro}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppRadius_MD}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource AppGridHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NOMBRE" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="CAJA" Style="{StaticResource AppGridHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="INVENT." Style="{StaticResource AppGridHeaderTextStyle}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="EmptyStateText"
                            Text="Sin usuarios para mostrar."
                            Style="{StaticResource AppTableCellStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AppDataGridRowButtonStyle}"
                                                Click="OnRowClick"
                                                Tag="{Binding Id}"
                                                TabIndex="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FirstName}" ToolTip="{Binding FirstName}" TextTrimming="CharacterEllipsis" Style="{StaticResource AppTableCellStyle}" />
                                                    <TextBlock Text="{Binding LastName}" Foreground="{StaticResource AppGrisClaro}" FontSize="{StaticResource AppFontSize_XS}" Margin="8,0,0,4" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CanCashier}" Style="{StaticResource AppTableCellStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CanSell}" Style="{StaticResource AppTableCellStyle}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Formulario -->
        <Border
            Grid.Column="1"
            Background="{StaticResource AppAzulMedio}"
            BorderBrush="{StaticResource AppAzulClaro}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppRadius_MD}"
            Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="Nuevo usuario" Style="{StaticResource AppPanelTitleStyle}" Margin="0,0,0,12" />

                    <Label Content="Nombre" Target="{Binding ElementName=FirstNameBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <TextBox x:Name="FirstNameBox" MaxLength="{x:Static helpers:FieldConstraints.EmployeeFirstNameMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Nombre" Margin="0,4,0,10" TabIndex="2" />

                    <Label Content="Apellido" Target="{Binding ElementName=LastNameBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <TextBox x:Name="LastNameBox" MaxLength="{x:Static helpers:FieldConstraints.EmployeeLastNameMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Apellido" Margin="0,4,0,10" TabIndex="3" />

                    <Label Content="DUI" Target="{Binding ElementName=DuiBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="DuiBox" MaxLength="{x:Static helpers:FieldConstraints.EmployeeDuiMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="00000000-0" Margin="0,4,0,10" TabIndex="4" />

                    <Label Content="Departamento" Target="{Binding ElementName=DepartmentCombo}" Style="{StaticResource AppFieldLabelStyle}" />
                    <ComboBox x:Name="DepartmentCombo" Style="{StaticResource AppFieldComboBoxStyle}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                               SelectionChanged="OnDepartmentChanged" Margin="0,4,0,10" TabIndex="5" />

                    <Label Content="Cargo" Target="{Binding ElementName=PositionCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <ComboBox x:Name="PositionCombo" Style="{StaticResource AppFieldComboBoxStyle}"
                               DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10" TabIndex="6" />

                    <Label Content="Fecha de ingreso" Target="{Binding ElementName=HireDatePicker}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <DatePicker x:Name="HireDatePicker" Margin="0,4,0,10" TabIndex="7" />

                    <Label Content="Salario base" Target="{Binding ElementName=SalaryBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <TextBox x:Name="SalaryBox" Text="0" Style="{StaticResource AppFieldTextBoxStyle}" helpers:NumericInput.IsEnabled="True" helpers:NumericInput.Precision="{x:Static helpers:FieldConstraints.EmployeeBaseSalaryPrecision}" helpers:NumericInput.Scale="{x:Static helpers:FieldConstraints.EmployeeBaseSalaryScale}" helpers:WatermarkService.Watermark="0,00" Margin="0,4,0,10" TabIndex="8" />

                    <Label Content="Tipo de contrato" Target="{Binding ElementName=ContractCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <ComboBox x:Name="ContractCombo" Style="{StaticResource AppFieldComboBoxStyle}" SelectedIndex="0" Margin="0,4,0,10" TabIndex="9">
                        <ComboBoxItem Content="Plazo fijo" Tag="PLAZO_FIJO" />
                        <ComboBoxItem Content="Tiempo parcial" Tag="TIEMPO_PARCIAL" />
                        <ComboBoxItem Content="Honorarios" Tag="HONORARIOS" />
                        <ComboBoxItem Content="Pasante" Tag="PASANTE" />
                    </ComboBox>

                    <Label Content="Tipo de salario" Target="{Binding ElementName=SalaryTypeCombo}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <ComboBox x:Name="SalaryTypeCombo" Style="{StaticResource AppFieldComboBoxStyle}" SelectedIndex="0" Margin="0,4,0,10" TabIndex="10">
                        <ComboBoxItem Content="Mensual" Tag="MENSUAL" />
                        <ComboBoxItem Content="Quincenal" Tag="QUINCENAL" />
                        <ComboBoxItem Content="Semanal" Tag="SEMANAL" />
                    </ComboBox>

                    <Label Content="Teléfono" Target="{Binding ElementName=PhoneBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="PhoneBox" MaxLength="{x:Static helpers:FieldConstraints.EmployeePhoneMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Teléfono (opcional)" Margin="0,4,0,10" TabIndex="11" />

                    <Label Content="Correo" Target="{Binding ElementName=EmailBox}" Style="{StaticResource AppFieldLabelStyle}" />
                    <TextBox x:Name="EmailBox" MaxLength="{x:Static helpers:FieldConstraints.EmployeeEmailMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="correo@ejemplo.com" Margin="0,4,0,10" TabIndex="12" />

                    <CheckBox x:Name="CanCashierCheck" Content="Puede operar Caja" Foreground="{StaticResource AppBlanco}" Margin="0,4,0,6" TabIndex="13" />
                    <CheckBox x:Name="CanSellCheck" Content="Puede gestionar Inventario" Foreground="{StaticResource AppBlanco}" Margin="0,0,0,10" TabIndex="14" />

                    <Label x:Name="PinLabel" Content="PIN de acceso (4 dígitos)" Target="{Binding ElementName=PinBox}" Style="{StaticResource RequiredLabelStyle}" helpers:FieldHelper.IsRequired="True" />
                    <!-- PasswordBox: el PIN no debe mostrarse en claro (antes era TextBox). -->
                    <PasswordBox x:Name="PinBox" MaxLength="4" Height="36" Padding="12,7"
                                 Background="{StaticResource AppAzulOscuro}"
                                 BorderBrush="{StaticResource AppAzulClaro}"
                                 BorderThickness="1"
                                 Foreground="{StaticResource AppBlanco}"
                                 CaretBrush="{StaticResource AppBlanco}"
                                 FontFamily="{StaticResource AppFontFamily}"
                                 FontSize="{StaticResource AppFontSize_MD}"
                                  Margin="0,4,0,10" TabIndex="15" />

                    <TextBlock x:Name="FormErrorText" Foreground="{StaticResource AppError}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource AppPrimaryWideButtonStyle}" Click="OnGuardarClick" Margin="0,0,6,0" TabIndex="20" AutomationProperties.Name="Guardar usuario" AutomationProperties.AcceleratorKey="Ctrl+S">
                            <TextBlock Text="GUARDAR (Ctrl+S)" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource AppSecondaryWideButtonStyle}" Click="OnCancelarClick" Margin="6,0,0,0" TabIndex="21" AutomationProperties.Name="Cancelar edición" AutomationProperties.AcceleratorKey="Escape">
                            <TextBlock Text="LIMPIAR (Esc)" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                        </Button>
                    </Grid>
                    <Button x:Name="DeactivateButton" Style="{StaticResource AppSecondaryWideButtonStyle}"
                            Click="OnDesactivarClick" Margin="0,10,0,0" Visibility="Collapsed" TabIndex="22" AutomationProperties.Name="Desactivar usuario" AutomationProperties.AcceleratorKey="Delete">
                        <TextBlock Text="DESACTIVAR (Supr)" Foreground="{StaticResource AppError}" FontWeight="Bold" />
                    </Button>

                    <Border Margin="0,18,0,0" Padding="12"
                            Background="{StaticResource AppAzulOscuro}"
                            BorderBrush="{StaticResource AppAzulClaro}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Desbloquear terminal" Style="{StaticResource AppCardLabelStyle}" />
                            <TextBlock Text="Requiere permiso de administrador y registra la acción." Foreground="{StaticResource AppGrisClaro}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <TextBlock Text="Código de caja" Style="{StaticResource AppCardLabelStyle}" />
                             <TextBox x:Name="CashRegisterCodeBox" MaxLength="{x:Static helpers:FieldConstraints.EmployeeCashRegisterCodeMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" Margin="0,4,0,10" TabIndex="16" />
                            <Label Content="Motivo (opcional)" Target="{Binding ElementName=UnlockReasonBox}" Style="{StaticResource AppFieldLabelStyle}" />
                            <TextBox x:Name="UnlockReasonBox" MaxLength="{x:Static helpers:FieldConstraints.EmployeeUnlockReasonMaxLength}" helpers:WatermarkService.Watermark="Motivo de desbloqueo" Style="{StaticResource AppFieldTextBoxStyle}" Margin="0,4,0,10" TabIndex="17" />
                            <Button Style="{StaticResource AppSecondaryWideButtonStyle}" Click="OnUnlockTerminalClick" TabIndex="23">
                                <TextBlock Text="DESBLOQUEAR" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
                            </Button>
                            <TextBlock x:Name="UnlockStatusText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

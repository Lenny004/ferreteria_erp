<UserControl
    x:Class="Ferreteria.PuntoVenta.Views.Inventario.AlertasView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Ferreteria.PuntoVenta.Helpers"
    xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
    FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}">
    <!-- Atajos: F2/Ctrl+F filtrar alertas y F5 actualizar. -->
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static input:ApplicationCommands.Find}" Executed="OnFindCommandExecuted" />
        <CommandBinding Command="{x:Static input:NavigationCommands.Refresh}" Executed="OnRefreshCommandExecuted" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{x:Static input:ApplicationCommands.Find}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static input:ApplicationCommands.Find}" />
        <KeyBinding Key="F5" Command="{x:Static input:NavigationCommands.Refresh}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Alertas de Stock" Style="{StaticResource AppPanelTitleStyle}" />
                <TextBlock Text="Productos en o por debajo del stock mínimo · F2/Ctrl+F filtrar · F5 actualizar" Style="{StaticResource AppPanelSubtitleStyle}" />
                <Label Content="Filtrar alertas (F2/Ctrl+F)" Target="{Binding ElementName=SearchTextBox}" Style="{StaticResource AppFieldLabelStyle}" Margin="0,8,0,0" />
                <TextBox x:Name="SearchTextBox" MaxLength="{x:Static helpers:FieldConstraints.ProductSearchMaxLength}" Style="{StaticResource AppFieldTextBoxStyle}" helpers:WatermarkService.Watermark="Código, descripción o estado" TextChanged="OnSearchChanged" TabIndex="0" AutomationProperties.Name="Filtrar alertas" AutomationProperties.AcceleratorKey="F2, Ctrl+F" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource AppSecondaryWideButtonStyle}" Click="OnActualizarClick" TabIndex="1" AutomationProperties.Name="Actualizar alertas" AutomationProperties.AcceleratorKey="F5">
                <TextBlock Text="ACTUALIZAR (F5)" Foreground="{StaticResource AppBlanco}" FontWeight="Bold" />
            </Button>
        </Grid>
        <Border
            Grid.Row="1"
            Background="{StaticResource AppAzulMedio}"
            BorderBrush="{StaticResource AppAzulClaro}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppRadius_MD}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource AppGridHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CODIGO" Style="{StaticResource AppGridHeaderTextStyle}" />
                    <TextBlock Grid.Column="1" Text="PRODUCTO" Style="{StaticResource AppGridHeaderTextStyle}" />
                    <TextBlock Grid.Column="2" Text="STOCK" Style="{StaticResource AppGridHeaderTextStyle}" />
                    <TextBlock Grid.Column="3" Text="MINIMO" Style="{StaticResource AppGridHeaderTextStyle}" />
                    <TextBlock Grid.Column="4" Text="ESTADO" Style="{StaticResource AppGridHeaderTextStyle}" />
                </Grid>
                <Grid Grid.Row="1">
                    <TextBlock
                        x:Name="EmptyStateText"
                        Text="No hay alertas de stock activas."
                        Style="{StaticResource AppTableCellStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsList">
                            <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                    <Button Style="{StaticResource AppDataGridRowButtonStyle}" AutomationProperties.Name="Alerta de stock" TabIndex="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProductCode}" Style="{StaticResource AppTableCellStyle}" Foreground="{StaticResource AppRojo}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductCode}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProductDescription}" Style="{StaticResource AppTableCellStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductDescription}" />
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentStockText}" Style="{StaticResource AppTableCellStyle}" />
                                            <TextBlock Grid.Column="3" Text="{Binding MinStockText}" Style="{StaticResource AppTableCellStyle}" />
                                            <Border Grid.Column="4" Style="{StaticResource AppBadgeStyle}" Background="{StaticResource AppWarning}">
                                                <TextBlock Text="{Binding AlertType}" Foreground="{StaticResource AppNegro}" FontSize="{StaticResource AppFontSize_XS}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
